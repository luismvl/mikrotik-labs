# FRP client configuration for local PC
# Copy to config/frpc.toml and fill in your VPS details.
# FRP v0.6x TOML syntax.

serverAddr = "YOUR_VPS_IP_OR_DOMAIN"
serverPort = 43700
auth.token = "YOUR_STRONG_TOKEN_HERE"

# Proxy the frontend (Vite dev server) so it is reachable remotely at:
#   http://YOUR_VPS_IP_OR_DOMAIN:43180
[[proxies]]
name = "frontend"
type = "tcp"
localIP = "127.0.0.1"
localPort = 43180
remotePort = 43180

# RouterOS access ports for the currently active lab. Only one lab should run
# at a time, so all labs can reuse the same public ports.
[[proxies]]
name = "r1-winbox"
type = "tcp"
localIP = "127.0.0.1"
localPort = 43291
remotePort = 43291

[[proxies]]
name = "r1-ssh"
type = "tcp"
localIP = "127.0.0.1"
localPort = 43221
remotePort = 43221

[[proxies]]
name = "r1-webfig"
type = "tcp"
localIP = "127.0.0.1"
localPort = 43281
remotePort = 43281

[[proxies]]
name = "r2-winbox"
type = "tcp"
localIP = "127.0.0.1"
localPort = 43292
remotePort = 43292

[[proxies]]
name = "r2-ssh"
type = "tcp"
localIP = "127.0.0.1"
localPort = 43222
remotePort = 43222

[[proxies]]
name = "r2-webfig"
type = "tcp"
localIP = "127.0.0.1"
localPort = 43282
remotePort = 43282

[[proxies]]
name = "r3-winbox"
type = "tcp"
localIP = "127.0.0.1"
localPort = 43293
remotePort = 43293

[[proxies]]
name = "r3-ssh"
type = "tcp"
localIP = "127.0.0.1"
localPort = 43223
remotePort = 43223

[[proxies]]
name = "r3-webfig"
type = "tcp"
localIP = "127.0.0.1"
localPort = 43283
remotePort = 43283
