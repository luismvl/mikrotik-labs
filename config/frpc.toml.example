# FRP client configuration for local PC
# Copy to config/frpc.toml and fill in your VPS details.
# FRP v0.6x TOML syntax.

serverAddr = "YOUR_VPS_IP_OR_DOMAIN"
serverPort = 7000
token = "YOUR_STRONG_TOKEN_HERE"

# Optional: keepalive for stability
tcpMuxKeepaliveInterval = 30

# Proxy the frontend (Vite dev server) so it is reachable remotely.
[[proxies]]
name = "frontend"
type = "http"
localIP = "127.0.0.1"
localPort = 5173
customDomains = ["frontend.YOUR_DOMAIN"]

# Proxy the backend API so it is reachable remotely.
[[proxies]]
name = "backend"
type = "http"
localIP = "127.0.0.1"
localPort = 3001
customDomains = ["backend.YOUR_DOMAIN"]

# Example: proxy WinBox to a local MikroTik device (optional).
# [[proxies]]
# name = "winbox"
# type = "tcp"
# localIP = "192.168.88.1"
# localPort = 8291
# remotePort = 18291
